#!/bin/bash
#
# config and common vars

export maindir="$(pwd)"
export outside="${maindir}/.."

#

export ARCH="arm64"
export SUBARCH="arm64"
export KBUILD_BUILD_USER="nijuugo-ji"
export KBUILD_BUILD_HOST="telegram-de"

export defconfig="selene_defconfig"

if [[ -z "$zipper_repo" ]]; then
  export zipper_repo="https://github.com/mochenya/AnyKernel3-niigo"
fi
if [[ -z "$zipper_branch" ]]; then
  export zipper_branch=yuki
fi

export out_image="${maindir}/out/arch/${ARCH}/boot/Image.gz-dtb"
export out_dtb="${maindir}/out/arch/${ARCH}/boot/dts/mediatek/mt6768.dtb"
export out_dtbo="${maindir}/out/arch/${ARCH}/boot/dtbo.img"

export zipper="${outside}/zipper"

#

export defconfig_file="${maindir}/arch/${ARCH}/configs/${defconfig}"

export kernel_head="$(git log --pretty=format:'%h' -1)"
export kernel_name=$(cat "${defconfig_file}" | grep "CONFIG_LOCALVERSION=" | sed 's/CONFIG_LOCALVERSION="-*//g' | sed 's/"*//g' )
export kernel_ver="$(make kernelversion)"
export TIME=$(date +"%y%m%d-%H%M")

export zip_name="${maindir}/${kernel_name}${SUFFIX}-${TIME}-${kernel_head}.zip"

# Print env
echo "=================== Environment Variables ==================="
echo "maindir: $maindir"
echo "outside: $outside"
echo "ARCH: $ARCH"
echo "SUBARCH: $SUBARCH"
echo "KBUILD_BUILD_USER: $KBUILD_BUILD_USER"
echo "KBUILD_BUILD_HOST: $KBUILD_BUILD_HOST"
echo "defconfig: $defconfig"
echo "zipper_repo: $zipper_repo"
echo "zipper_branch: $zipper_branch"
echo "out_image: $out_image"
echo "out_dtb: $out_dtb"
echo "out_dtbo: $out_dtbo"
echo "zipper: $zipper"
echo "defconfig_file: $defconfig_file"
echo "kernel_head: $kernel_head"
echo "kernel_name: $kernel_name"
echo "kernel_ver: $kernel_ver"
echo "TIME: $TIME"
echo "zip_name: $zip_name"
echo "============================================================"